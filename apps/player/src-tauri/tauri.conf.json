{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Board RPG Player",
  "version": "0.5.0",
  "identifier": "io.github.adrianderstroff.boardrpg.player",
  "build": {
    "frontendDist": "../../../dist-player"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Board RPG", "width": 1280, "height": 720, "minWidth": 480, "minHeight": 270, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["brpg"], "name": "Board RPG game", "description": "A game made with the Board RPG editor", "role": "Viewer", "mimeType": "application/x-brpg" }],
    "shortDescription": "Plays Board RPG games",
    "longDescription": "Plays games made with the Board RPG editor (.brpg files)."
  }
}
